# Ignore everything
*

# Dont ignore .gitignore itself
!.gitignore

# Allow .config
!.config/

# Allow README
!README.md

# Standlone config files
!.config/mimeapps.list
!/.bashrc


# Config directories
!.config/fontconfig/
!.config/fontconfig/**

!.config/hypr/
!.config/hypr/**

!.config/niri/
!.config/niri/**
.config/niri/current-theme.kdl

!.config/kitty/
!.config/kitty/**
.config/kitty/current-theme.conf

!.config/quickshell/
!.config/quickshell/**
.config/quickshell/user-preferences.json

!.config/waybar/
!.config/waybar/**

!.config/waypaper/
!.config/waypaper/**